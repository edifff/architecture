{
  "uid": "arch-labs-layers",
  "title": "arch-labs: слои под нагрузкой",
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "RPS по сервисам",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(rpc_calls_total[30s]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 латентности, мс",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le, service) (rate(rpc_latency_seconds_bucket[30s])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ошибки, % вызовов",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "100 * sum by (service) (rate(rpc_calls_total{status!=\"OK\"}[30s])) / clamp_min(sum by (service) (rate(rpc_calls_total[30s])), 0.001)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Вызовы по методам",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (method) (rate(rpc_calls_total[30s]))",
          "legendFormat": "{{method}}"
        }
      ]
    }
  ]
}
