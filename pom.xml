<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.archlabs</groupId>
    <artifactId>arch-labs</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- Реактор многоуровневой архитектуры:
         proto            — общий контракт (protobuf + кодоген gRPC);
         core             — доменное ядро (модели, интерфейсы, ChatServerImpl);
         storage-service  — слой хранения: gRPC + JDBC/PostgreSQL;
         chat-service     — доменный слой: gRPC поверх ChatServerImpl;
         api              — входной элемент: Facade (разбор, проверка,
                            конвертация в protobuf) и gRPC-клиент к chat. -->

    <modules>
        <module>proto</module>
        <module>core</module>
        <module>storage-service</module>
        <module>chat-service</module>
        <module>api</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <postgresql.version>42.7.4</postgresql.version>
        <flyway.version>10.20.1</flyway.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <netty.version>4.2.19.Final</netty.version>
        <jackson.version>2.18.11</jackson.version>
        <prometheus.version>1.4.3</prometheus.version>
        <!-- Контракты: версии gRPC/protobuf согласованы между собой —
             protoc и protoc-gen-grpc-java обязаны совпадать по версии
             с protobuf-java (с 4.26 нумерация протокола зеркалит рантайм). -->
        <grpc.version>1.85.1</grpc.version>
        <protobuf.version>4.36.2</protobuf.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-this-escape</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.io.tmpdir>${project.build.directory}</java.io.tmpdir>
                        <api.version>1.40</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
